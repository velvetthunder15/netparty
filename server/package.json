{
  "name": "netparty-server",
  "version": "1.0.0",
  "description": "Room-based WebSocket sync server for the NetParty watch-party extension",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "node test.js",
    "build:zip": "cd ../extension && rm -f ../server/worker/public/netparty-extension.zip && mkdir -p ../server/worker/public && zip -qr ../server/worker/public/netparty-extension.zip . -x '.*'",
    "deploy": "npm run build:zip && cd worker && npx wrangler deploy"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
